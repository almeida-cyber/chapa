{
  "rules": {
    "configuracoes": {
      "lojaAberta": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "newData.isBoolean()"
      },
      ".read": false,
      ".write": false
    },
    "produtos": {
      ".read": true,
      ".write": "auth != null"
    },
    "pedidos": {
      ".read": "auth != null",
      ".indexOn": ["criadoEm"],
      "$pedidoId": {
        ".write": "!data.exists() || auth != null"
      }
    }
  }
}
